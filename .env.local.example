DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=generate-a-long-random-string-for-signing-session-cookies
AUTH_PASSWORD_RIA=changeme
AUTH_PASSWORD_DAD=changeme

# Phase 7 (email ingest via /api/inbound) — shared secret the Cloudflare Worker
# sends back, and the sender-email allowlists used to attribute a save to a person.
INBOUND_SHARED_SECRET=generate-a-long-random-string
RIA_EMAILS=ria@example.com
DAD_EMAILS=dad@example.com,dad-alternate@example.com
